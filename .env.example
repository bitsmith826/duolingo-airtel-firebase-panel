# ================================================================
# KONFIGURASI DUOLINGO x AIRTEL FIREBASE PANEL WORKER
# ================================================================

# Mode tampilan browser:
# false = Munculkan jendela Chrome di layar (bagus untuk memantau langsung)
# true  = Sembunyikan browser di latar belakang (background / headless)
HEADLESS=true

# Jumlah worker yang memproses secara paralel (disarankan 1 - 2 agar stabil)
MAX_WORKERS=1

# Batas nomor yang diproses per eksekusi (0 = proses semua nomor yang ditemukan)
MAX_NUMBERS=0
